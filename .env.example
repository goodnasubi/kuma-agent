# kuma-agent の設定見本。コピーして .env を作り、使う分だけ値を入れる。
#   cp .env.example .env
# .env には秘密のキーが入るので、他人と共有したり Git に入れたりしないこと。

# 頭脳の選択（muse / claude / gemini のどれか）
# コンテナの中では CLI 系（claude-code など）は使えないので、API 系から選ぶ
KUMA_LLM_PROVIDER=gemini

# モデルの上書き（空なら頭脳ごとの既定モデルになる）
KUMA_LLM_MODEL=

# Gemini の API キー（KUMA_LLM_PROVIDER=gemini のとき必要）
GEMINI_API_KEY=

# Meta Model API のキー（KUMA_LLM_PROVIDER=muse のとき必要）
META_MODEL_API_KEY=

# Claude API のキー（KUMA_LLM_PROVIDER=claude のとき必要）
ANTHROPIC_API_KEY=

# Telegram 接続（使うときだけ。トークンは Telegram の @BotFather で発行する）
KUMA_TELEGRAM_BOT_TOKEN=

# Telegram で会話を許可する chat id（カンマ区切り。空だと誰の会話も処理しない）
KUMA_TELEGRAM_ALLOWED_CHATS=
